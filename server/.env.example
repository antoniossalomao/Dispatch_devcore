# copie esse arquivo pra um chamado .env se quiser mudar alguma configuração

# defina "production" ao publicar na web (Azure App Service)
NODE_ENV=

# caminho do arquivo sqlite (se deixar vazio, cria em server/data/dispatch.db; na Azure use /home/data/dispatch.db)
DB_CAMINHO=

# segredo forte para assinar a sessão (ex.: gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# código de convite para liberar auto-cadastro público (deixe vazio para manter o auto-cadastro bloqueado)
CADASTRO_CODIGO=

# chave da IA (https://console.groq.com/keys). vazio = IA desligada
GROQ_API_KEY=

# alertas críticos pelo Telegram: crie um bot no @BotFather e cole o token. vazio = só aparece no terminal
TELEGRAM_BOT_TOKEN=
# chat padrão que recebe os alertas (usado quando o usuário não tem o próprio ID de chat)
TELEGRAM_CHAT_ID=

# login com Google (opcional): crie as credenciais em console.cloud.google.com (APIs e serviços > Credenciais).
# vazio = o botão "Entrar com Google" não aparece
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# endereço de retorno; se vazio, usa https://<domínio>/api/auth/google/retorno
GOOGLE_REDIRECT_URI=

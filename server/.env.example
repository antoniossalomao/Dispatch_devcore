# copie esse arquivo pra um chamado .env se quiser mudar alguma configuração

# caminho do arquivo sqlite (se deixar vazio, cria em server/data/dispatch.db)
DB_CAMINHO=

# segredo pra assinar o cookie da sessão de login
SESSION_SECRET=dispatch-devcore-segredo

# chave da IA (https://console.groq.com/keys). vazio = IA desligada
GROQ_API_KEY=
